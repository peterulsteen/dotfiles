#!/usr/bin/env bash
# Bootstrap step 1: install OS-native package manager (if needed) and Layer 3 packages.
#
# This is `run_onchange_*` (not `run_once_*`) -- chezmoi re-runs it whenever the
# rendered script content changes, so editing the Brewfile or a packages/*.txt
# list actually takes effect on the next `chezmoi apply` instead of silently
# doing nothing until someone remembers to run `brew bundle` by hand. Idempotent
# -- safe to re-run (brew bundle / apt-get / pacman / dnf install are all
# no-ops for already-installed packages).
#
# Content hashes below force a re-render (and re-run) whenever a package list
# changes:
# Brewfile hash: {{ include "Brewfile.darwin.tmpl" | sha256sum }}
# debian.txt hash: {{ include "packages/debian.txt" | sha256sum }}
# arch.txt hash: {{ include "packages/arch.txt" | sha256sum }}
# fedora.txt hash: {{ include "packages/fedora.txt" | sha256sum }}
#
# Layer 1 self-managers (mise, uv, rustup, claude, codex) are installed in step 20.
# Layer 2 mise-managed tools are installed in step 30.
#
# Chezmoi exposes the OS via templating (shown without braces so chezmoi does
# NOT evaluate them here -- .chezmoi.osRelease is absent on macOS and would
# error under missingkey=error):
#   .chezmoi.os               → "darwin" | "linux"
#   .chezmoi.osRelease.id     → "pop" | "ubuntu" | "arch" | "fedora" (Linux only)
#   .chezmoi.osRelease.idLike → e.g. "ubuntu debian" for Pop!_OS

set -euo pipefail

log()  { printf '\033[1;34m[bootstrap]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[bootstrap]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[bootstrap]\033[0m %s\n' "$*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

# --- Determine OS + distro from chezmoi templating ---
OS="{{ .chezmoi.os }}"
{{- if eq .chezmoi.os "linux" }}
DISTRO_ID="{{ .chezmoi.osRelease.id }}"
DISTRO_LIKE="{{ .chezmoi.osRelease.idLike | default "" }}"
{{- else }}
DISTRO_ID=""
DISTRO_LIKE=""
{{- end }}

# Personal vs. work-managed machine (from the `chezmoi init` prompt). Drives
# whether 1password-cli gets installed -- see README's Secrets section.
# Defensive default = false (skip), so a machine that hasn't re-run
# `chezmoi init` for this prompt doesn't unexpectedly gain a new package.
{{- $isPersonal := false }}{{ if hasKey . "isPersonal" }}{{ $isPersonal = .isPersonal }}{{ end }}
IS_PERSONAL={{ $isPersonal }}

log "OS=${OS} DISTRO_ID=${DISTRO_ID} DISTRO_LIKE=${DISTRO_LIKE} IS_PERSONAL=${IS_PERSONAL}"

# Path to this repo's package lists, available at apply time:
PKG_DIR="{{ .chezmoi.sourceDir }}/packages"
BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile.darwin.tmpl"

# --- Helper: install Homebrew on macOS if missing ---
install_homebrew_if_missing() {
    if have brew; then
        log "Homebrew already installed: $(brew --version | head -1)"
        return
    fi
    # On a fresh Mac /opt/homebrew doesn't exist, so Homebrew needs sudo to create
    # and chown it. We run the installer NONINTERACTIVE (below) to skip its "press
    # RETURN" prompt, but that also switches its sudo check to `sudo -n`, which
    # ABORTS with "Need sudo access on macOS" if no sudo credential is cached --
    # even for admins, because `-n` refuses to prompt. So prime the sudo timestamp
    # here first (one password prompt); the non-interactive install then proceeds.
    log "Homebrew needs sudo to create /opt/homebrew — priming sudo (enter your password if asked)..."
    if ! sudo -v; then
        die "Could not obtain sudo. Re-run in an interactive terminal, or install Homebrew manually first:
  /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"
then re-run \`chezmoi apply\`."
    fi
    log "Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c \
        "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
}

# --- Helper: install brew packages from Brewfile ---
install_brew_packages() {
    log "Installing macOS Homebrew packages from Brewfile..."
    # BREWFILE points at the raw .tmpl source, not the rendered ~/Brewfile.darwin
    # target -- deliberately: this script is `_before_`, so it runs before
    # chezmoi has written any regular files to disk, and ~/Brewfile.darwin
    # wouldn't exist yet on a truly fresh machine's first apply. That means we
    # MUST render it ourselves here rather than handing brew the raw template
    # text (which contains unrendered chezmoi template syntax that brew can't
    # parse as Ruby).
    # NB: `--no-lock` was removed from `brew bundle` (Brewfile.lock.json is no
    # longer generated), so passing it now errors. Modern brew bundle is
    # lockfile-free by default.
    brew bundle --file=<(chezmoi execute-template < "${BREWFILE}")
}

# --- Helper: install packages from a newline-separated list, ignoring blank/comment lines ---
read_pkg_list() {
    grep -vE '^\s*(#|$)' "$1" | tr '\n' ' '
}

# --- Helper: configure Google Cloud CLI apt repo (google-cloud-cli is not in
# Debian/Ubuntu's default repos). Idempotent. Must run before `apt-get install`. ---
setup_gcloud_apt_repo() {
    local keyring=/usr/share/keyrings/cloud.google.gpg
    local list=/etc/apt/sources.list.d/google-cloud-sdk.list
    if [ -f "$keyring" ] && [ -f "$list" ]; then
        log "Google Cloud apt repo already configured."
        return
    fi
    log "Configuring Google Cloud apt repo..."
    sudo apt-get update
    sudo apt-get install -y apt-transport-https ca-certificates gnupg curl
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | sudo gpg --dearmor -o "$keyring"
    echo "deb [signed-by=${keyring}] https://packages.cloud.google.com/apt cloud-sdk main" \
        | sudo tee "$list" >/dev/null
}

# --- Helper: configure Google Cloud CLI dnf repo (Fedora consumes Google's EL9
# yum repo). Idempotent. Must run before `dnf install`. Settings mirror Google's
# documented RHEL/Fedora repo; $basearch resolves to x86_64 on the owner's box.
# aarch64 yum coverage lags — pin the arch in baseurl if installing on ARM. ---
setup_gcloud_dnf_repo() {
    local repo=/etc/yum.repos.d/google-cloud-cli.repo
    if [ -f "$repo" ]; then
        log "Google Cloud dnf repo already configured."
        return
    fi
    log "Configuring Google Cloud dnf repo..."
    sudo tee "$repo" >/dev/null <<'EOF'
[google-cloud-cli]
name=Google Cloud CLI
baseurl=https://packages.cloud.google.com/yum/repos/cloud-sdk-el9-$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://packages.cloud.google.com/yum/doc/rpm-package-key.gpg
EOF
}

# --- Helper: install 1password-cli on personal Debian/Ubuntu machines, via
# 1Password's own apt repo (not in default repos). Idempotent. ---
install_1password_cli_debian() {
    if have op; then
        log "1Password CLI already installed: $(op --version)"
        return
    fi
    log "Installing 1Password CLI (personal machine)..."
    local arch keyring=/usr/share/keyrings/1password-archive-keyring.gpg
    arch="$(dpkg --print-architecture)"
    curl -sS https://downloads.1password.com/linux/keys/1password.asc \
        | sudo gpg --dearmor --output "$keyring"
    echo "deb [arch=${arch} signed-by=${keyring}] https://downloads.1password.com/linux/debian/${arch} stable main" \
        | sudo tee /etc/apt/sources.list.d/1password.list >/dev/null
    sudo apt-get update
    sudo apt-get install -y 1password-cli
}

# --- Helper: install 1password-cli on personal Fedora machines, via
# 1Password's own dnf repo. Idempotent. ---
install_1password_cli_fedora() {
    if have op; then
        log "1Password CLI already installed: $(op --version)"
        return
    fi
    log "Installing 1Password CLI (personal machine)..."
    sudo rpm --import https://downloads.1password.com/linux/keys/1password.asc
    sudo tee /etc/yum.repos.d/1password.repo >/dev/null <<'EOF'
[1password]
name=1Password Stable Channel
baseurl=https://downloads.1password.com/linux/rpm/stable/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey="https://downloads.1password.com/linux/keys/1password.asc"
EOF
    sudo dnf install -y 1password-cli
}

# --- Helper: install 1password-cli on personal Arch machines, from the AUR.
# No AUR helper (yay/paru) is installed anywhere else in this repo, so build it
# directly with makepkg rather than adding a new Layer-3 dependency just for
# this one package. Idempotent. ---
install_1password_cli_arch() {
    if have op; then
        log "1Password CLI already installed: $(op --version)"
        return
    fi
    log "Installing 1Password CLI from AUR (personal machine)..."
    local build_dir
    build_dir="$(mktemp -d)"
    git clone --depth=1 https://aur.archlinux.org/1password-cli.git "$build_dir"
    (cd "$build_dir" && makepkg -si --noconfirm)
    rm -rf "$build_dir"
}

# --- OS dispatch ---
# Match on $DISTRO_ID first (most specific). Fall back to $DISTRO_LIKE for
# derivatives we haven't named explicitly. Keep it as a flat routing table.
case "$OS" in
    darwin)
        install_homebrew_if_missing
        install_brew_packages
        ;;
    linux)
        case "$DISTRO_ID" in
            pop|ubuntu|debian)
                log "Installing apt packages (id=${DISTRO_ID})..."
                setup_gcloud_apt_repo
                sudo apt-get update
                sudo apt-get install -y $(read_pkg_list "${PKG_DIR}/debian.txt")
                [ "$IS_PERSONAL" = true ] && install_1password_cli_debian
                ;;
            arch)
                log "Installing pacman packages..."
                sudo pacman -Syu --noconfirm --needed $(read_pkg_list "${PKG_DIR}/arch.txt")
                [ "$IS_PERSONAL" = true ] && install_1password_cli_arch
                ;;
            fedora)
                log "Installing dnf packages..."
                setup_gcloud_dnf_repo
                sudo dnf install -y $(read_pkg_list "${PKG_DIR}/fedora.txt")
                [ "$IS_PERSONAL" = true ] && install_1password_cli_fedora
                ;;
            *)
                case "$DISTRO_LIKE" in
                    *debian*)
                        log "Falling back to debian via idLike (${DISTRO_LIKE})..."
                        setup_gcloud_apt_repo
                        sudo apt-get update
                        sudo apt-get install -y $(read_pkg_list "${PKG_DIR}/debian.txt")
                        [ "$IS_PERSONAL" = true ] && install_1password_cli_debian
                        ;;
                    *arch*)
                        log "Falling back to arch via idLike (${DISTRO_LIKE})..."
                        sudo pacman -Syu --noconfirm --needed $(read_pkg_list "${PKG_DIR}/arch.txt")
                        [ "$IS_PERSONAL" = true ] && install_1password_cli_arch
                        ;;
                    *fedora*|*rhel*)
                        log "Falling back to fedora via idLike (${DISTRO_LIKE})..."
                        setup_gcloud_dnf_repo
                        sudo dnf install -y $(read_pkg_list "${PKG_DIR}/fedora.txt")
                        [ "$IS_PERSONAL" = true ] && install_1password_cli_fedora
                        ;;
                    *)
                        die "Unsupported Linux distro: id=${DISTRO_ID} idLike=${DISTRO_LIKE}"
                        ;;
                esac
                ;;
        esac
        ;;
    *)
        die "Unsupported OS: ${OS}"
        ;;
esac

log "Layer 3 packages installed."
