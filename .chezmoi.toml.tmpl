{{/*
  Chezmoi config template — runs once at `chezmoi init`.
  Prompts for per-machine values and stores them in
  ~/.config/chezmoi/chezmoi.toml (NOT in this repo).

  These values are then available to all other templates via .name, .email, etc.
*/ -}}

{{- $name        := promptStringOnce . "name"        "Full name for git commits" -}}
{{- $email       := promptStringOnce . "email"       "Email for git commits" -}}
{{- $signingkey  := promptStringOnce . "signingkey"  "SSH signing public key from 1Password, literal content (e.g. 'ssh-ed25519 AAAA...'), or blank to generate a local key and upload it to GitHub" "" -}}
{{- $isPersonal  := promptBoolOnce   . "isPersonal"  "Is this a personal (non-work-managed) machine?" -}}
{{- $isWorkstation := promptBoolOnce . "isWorkstation" "Is this a workstation (full zsh + sheldon plugins)? No = lean server/VM" true -}}
{{- $workEmail   := promptStringOnce . "workEmail"   "Work email for work-directory repos (blank if none)" "" -}}
{{- $workdir     := promptStringOnce . "workdir"     "Path under which work repos live, for the git identity override (blank if none)" "" -}}

{{- /* Detected, not prompted. Omarchy is Arch plus Omarchy's own packaged
       defaults under /usr/share/omarchy. Templates use this to layer on top of
       those defaults instead of replacing them. */ -}}
{{- $isOmarchy := false -}}
{{- if and (eq .chezmoi.os "linux") (stat "/usr/share/omarchy") }}{{ $isOmarchy = true }}{{ end -}}

# Record where this working tree lives so `chezmoi diff`/`apply` work without
# passing --source each time. On a fresh machine that `chezmoi init`s from
# GitHub, this resolves to chezmoi's default (~/.local/share/chezmoi); on this
# machine it resolves to ~/code/peterulsteen/dotfiles.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    name       = {{ $name       | quote }}
    email      = {{ $email      | quote }}
    signingkey = {{ $signingkey | quote }}
    isPersonal = {{ $isPersonal }}
    isWorkstation = {{ $isWorkstation }}
    isOmarchy  = {{ $isOmarchy }}
    workEmail  = {{ $workEmail  | quote }}
    workdir    = {{ $workdir    | quote }}
