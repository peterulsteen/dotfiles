# Brewfile — macOS only (Layer 3: tools that need OS integration)
#
# Run with: brew bundle --file=Brewfile.darwin.tmpl
# This file is auto-applied by run_once_before_10-install-package-managers.sh.tmpl on macOS.
#
# DO NOT add tools here that belong in mise (Layer 2) or are self-managing (Layer 1).
# See CLAUDE.md for the layer decision tree.

# --- Shell ---
# zsh is the login + interactive shell; macOS ships /bin/zsh built-in, so only
# the plugin manager is installed here.
brew "sheldon"    # zsh plugin manager (workstation interactive stack)

# --- Container engine (Podman everywhere; no Docker) ---
brew "podman"
brew "podman-compose"
cask "podman-desktop"   # GUI; Podman replacement for Docker Desktop

# --- System crypto / signing ---
brew "gnupg"
brew "pinentry-mac"

# --- GNU coreutils for mac/Linux scripting parity ---
brew "coreutils"
brew "gnu-getopt"

# --- Secrets ---
brew "pass"
# NB: `vault` intentionally dropped — it lives in hashicorp/tap, which Homebrew
# 6.x refuses to load without `brew trust`. Not worth trusting a third-party tap.

# --- AWS ---
brew "awscli"

# --- Google Cloud ---
# Multi-file SDK with its own component manager → native pkg mgr, not mise.
# The cask disables the built-in updater; update via `brew upgrade --cask`.
# Auth/config lives in ~/.config/gcloud (secret-bearing, .chezmoiignore'd).
cask "gcloud-cli"

# --- Terminal emulator ---
cask "ghostty"

# --- Menu-bar system monitor ---
# GUI app → Layer 3. The cask is marked auto_updates (Stats ships its own
# updater), same situation as gcloud-cli above.
# Preferences are declared as `defaults write` calls in
# run_onchange_after_45-stats-defaults.sh.tmpl — NOT as a checked-in plist.
cask "stats"

# --- Fonts ---
cask "font-jetbrains-mono-nerd-font"

# --- Personal-only: 1Password CLI ---
# Uncomment on personal macOS machines. Leave commented on the work laptop.
# cask "1password-cli"
