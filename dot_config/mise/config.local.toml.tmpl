# mise tools manifest (Layer 2)
# Source of truth for all cross-platform CLIs and language runtimes.
# Same file applies to macOS, Pop!_OS, Arch/Omarchy, and Fedora.
#
# Deployed as ~/.config/mise/config.local.toml, NOT config.toml: mise gives
# config.local.toml priority over config.toml, and `mise use -g` writes to
# config.toml unless this file already declares the tool. So config.toml belongs
# to ad-hoc `mise use -g` (and Omarchy's ~/.local/bin wrappers, which run
# `mise use -g claude|codex|gh|...` on every launch), while this file wins any
# conflict, e.g. Omarchy pinning node to an exact version. gh stays spelled
# "aqua:cli/cli" below so the wrappers' `mise use -g gh` lands in config.toml
# instead of rewriting this file.
#
# DO NOT add tools that are owned by Layer 1 (self-managing: mise, uv, rustup, claude, codex)
# or by Layer 3 (OS-native: zsh, podman, gnupg, etc.).
# See CLAUDE.md for the layer decision tree.

[tools]

# --- Language runtimes ---
node       = "lts"
go         = "latest"
# Node 25+ stopped bundling corepack, which step 30 uses to provide pnpm/yarn.
"npm:corepack" = "latest"

# --- Infrastructure / IaC ---
terraform  = "latest"
opentofu   = "latest"
terragrunt = "latest"
kubectl    = "latest"
helm       = "latest"
k9s        = "latest"

# --- Databases (run locally) ---
postgres   = "18"

# --- Mise ecosystem ---
usage      = "latest"

# --- Shell utilities ---
"aqua:starship/starship"            = "latest"
"aqua:atuinsh/atuin"                = "latest"
"aqua:ajeetdsouza/zoxide"           = "latest"
# Multi-shell completion engine: bridges hundreds of CLIs (incl. gh, kubectl,
# docker) to zsh with zero per-tool setup. Self-updates like any other mise
# tool, so completions stay current without a regeneration script.
"aqua:carapace-sh/carapace-bin"     = "latest"
# eza publishes no macOS release binaries (aqua/ubi can't resolve them), so build
# from source via cargo — keeps it cross-platform in one file. rustup owns the toolchain.
"cargo:eza"                         = "latest"
"aqua:junegunn/fzf"                 = "latest"
"aqua:BurntSushi/ripgrep"           = "latest"
"aqua:sharkdp/fd"                   = "latest"
"aqua:sharkdp/bat"                  = "latest"
"aqua:dandavison/delta"             = "latest"
"aqua:jqlang/jq"                    = "latest"
# Prebuilt again: tealdeer's releases briefly shipped no binaries (hence a stint
# on cargo:tealdeer), and v1.9.0 restored them with checksums. Binary is `tldr`.
"aqua:tealdeer-rs/tealdeer"         = "latest"
"aqua:zellij-org/zellij"            = "latest"
"aqua:casey/just"                   = "latest"
"aqua:direnv/direnv"                = "latest"
yazi                                = "latest"   # terminal file manager

# --- Dev tools ---
"aqua:cli/cli"                      = "latest"   # gh
"aqua:jesseduffield/lazygit"        = "latest"
"aqua:neovim/neovim"                = "latest"
"aqua:tree-sitter/tree-sitter"      = "latest"
dagger                              = "latest"
turbo                               = "latest"   # npm:turbo; defers to a repo's pinned turbo

# --- Linters / formatters ---
"aqua:rhysd/actionlint"             = "latest"
"aqua:koalaman/shellcheck"          = "latest"
"aqua:JohnnyMorganz/StyLua"         = "latest"
"aqua:Kampfkarren/selene"           = "latest"

# --- Security ---
"aqua:gitleaks/gitleaks"            = "latest"   # powers the global pre-commit secret hook

# --- Lua language server (for Neovim) ---
"aqua:LuaLS/lua-language-server"    = "latest"

{{- $omarchy := false }}{{ if hasKey . "isOmarchy" }}{{ $omarchy = .isOmarchy }}{{ end }}
{{- if not $omarchy }}

[settings.self_update]
auto = true   # mise is Layer 1: it keeps itself current
{{- end }}
{{- /* Omarchy installs mise from pacman (mise-bin), so `omarchy update` keeps
       it current and mise's own self-update doesn't apply. */}}

[env]
# clbudget's pnpm shim must beat node's pnpm. Declaring it as a mise path keeps it
# first AND counts as mise-managed, so `mise doctor` stops flagging it. mise skips
# missing dirs, so this is a no-op where clbudget isn't installed.
_.path = ["~/.config/clbudget/bin"]
