theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-feature = calt
font-feature = liga

# Launch into a persistent Zellij session (attach-or-create "main") instead of a
# bare shell. This lives here, not in the shell rc, so the multiplexer ONLY
# starts in Ghostty -- integrated terminals in editors (VS Code, Cursor,
# Superset, JetBrains) get a plain shell because they never run this command.
#
# Absolute path: GUI-launched Ghostty may inherit a minimal PATH that omits
# package-manager bin dirs, so we hardcode the known location per OS.
# Exiting Zellij closes the window (no shell to fall back to) -- detach with the
# Zellij keybind to keep the session alive.
{{ if eq .chezmoi.os "darwin" -}}
command = /opt/homebrew/bin/zellij attach --create main
{{- else -}}
command = {{ .chezmoi.homeDir }}/.local/share/mise/shims/zellij attach --create main
{{- end }}
