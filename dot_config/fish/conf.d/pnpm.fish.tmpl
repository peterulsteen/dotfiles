# pnpm global bin lives in a different default path on each OS.
# Corepack-managed pnpm still honors PNPM_HOME for `pnpm install -g`.
{{ if eq .chezmoi.os "darwin" -}}
set -gx PNPM_HOME "$HOME/Library/pnpm"
{{- else -}}
set -gx PNPM_HOME "$HOME/.local/share/pnpm"
{{- end }}

if test -d $PNPM_HOME
    fish_add_path $PNPM_HOME
end
