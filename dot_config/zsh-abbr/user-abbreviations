# zsh-abbr abbreviations (https://github.com/olets/zsh-abbr).
# fish-style: expand inline at the prompt -- you see the real command before
# Enter. Stored format is `abbr "name"="expansion"`; edit
# here or via the `abbr` CLI (which rewrites this file).

# --- Listings (eza) ---
abbr "ll"="eza -lah --icons --git --group-directories-first"
abbr "la"="eza -lah --icons --git"
abbr "ltr"="eza --tree --icons --level 2"

# --- Cat / bat ---
abbr "bcat"="bat --paging=never"

# --- Git ---
abbr "gst"="git status"
abbr "gd"="git diff"
abbr "gds"="git diff --staged"
abbr "gl"="git pull"
abbr "gp"="git push"
abbr "gco"="git checkout"
abbr "gcm"="git commit -m"
abbr "gca"="git commit --amend --no-edit"
abbr "glo"="git log --oneline --graph --decorate"
abbr "lg"="lazygit"

# --- Container engine ---
# docker/docker-compose -> podman is NOT set here: the static abbr format can't
# express a `command -v docker` guard, and on the work Mac Dory provides a real
# `docker`. .zshrc defines both shims as guarded aliases (only when no real
# docker binary exists).

# --- Mise ---
abbr "mr"="mise run"
abbr "mu"="mise upgrade"
abbr "mls"="mise ls"

# --- AWS v1/v2 transition-era muscle memory ---
abbr "aws2"="aws"
