[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
{{- if .signingkey }}
    # Literal key content: 1Password's git-signing integration writes it inline
    # and fights a path reference.
    signingkey = {{ .signingkey | quote }}
{{- else }}
    # Blank signingkey at `chezmoi init`: a local key, generated and uploaded to
    # GitHub by run_once_after_60-ssh-signing-key.sh.tmpl. Pointing at the .pub
    # lets ssh-keygen use the agent if the key is loaded, else the private file.
    signingkey = {{ joinPath .chezmoi.homeDir ".ssh/id_ed25519_signing.pub" | quote }}
{{- end }}

[gpg]
    format = ssh
{{- if and .signingkey (eq .chezmoi.os "darwin") }}
{{-   $opSign := "/Applications/1Password.app/Contents/MacOS/op-ssh-sign" }}
{{-   if stat $opSign }}
# macOS: op-ssh-sign connects directly to the 1Password app IPC (already unlocked
# by the time you commit, thanks to macOS Keychain integration). NB: the signer
# lives inside the app bundle — /opt/1Password/op-ssh-sign is the LINUX path.
[gpg "ssh"]
    program = {{ $opSign }}

[commit]
    gpgsign = true
{{-   else }}
# macOS with a 1Password key but no 1Password app: no SSH signing helper exists
# and the key's private half lives in 1Password, so signing is impossible here.
# Commit unsigned rather than break every commit. Install 1Password and re-run
# `chezmoi apply`, or blank signingkey in ~/.config/chezmoi/chezmoi.toml to use a
# generated local key instead.
[commit]
    gpgsign = false
{{-   end }}
{{- else }}
# Linux, or a local key on any OS. Linux: op-ssh-sign cannot trigger a polkit
# unlock dialog when 1Password is locked; ssh-keygen routes through SSH_AUTH_SOCK
# (the 1Password agent), which CAN pop up a system-auth dialog on demand.
[gpg "ssh"]
    program = /usr/bin/ssh-keygen

[commit]
    gpgsign = true
{{- end }}

[push]
    autoSetupRemote = true

[init]
    defaultBranch = main

[core]
    excludesfile = ~/.config/git/ignore
    pager = delta
    # Global secret-scanning pre-commit hook for ALL repos. Repos that set their
    # own repo-local core.hooksPath (Husky v9, lefthook) override this and are
    # unaffected. See dot_config/git/hooks/executable_pre-commit.
    hooksPath = ~/.config/git/hooks

# gh is a Layer 2 (mise) tool on every OS, so the shim path is the same
# everywhere -- no per-OS branch needed (same reasoning as the Ghostty zellij
# command). MUST be the shims path, not a resolved installs/<version>/... path:
# the latter breaks silently on the next `gh` upgrade since that directory is
# removed when mise installs the new version.
[credential "https://github.com"]
    helper =
    helper = !{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh auth git-credential

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    syntax-theme = base16

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
    algorithm = histogram

[rerere]
    enabled = true

[pull]
    rebase = true
{{ if .workEmail }}
# Work identity: repos under the work directory author commits with the work
# email (see the included config-work). Everything else uses the personal
# email in [user] above. Both emails are verified on the same GitHub account,
# and the one signing key works for both, so only the author email changes.
[includeIf "gitdir:{{ .workdir }}/"]
    path = config-work
{{- end }}
