[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
    signingkey = {{ .signingkey | quote }}

[gpg]
    format = ssh
{{ if eq .chezmoi.os "darwin" }}
# macOS: op-ssh-sign connects directly to the 1Password app IPC (already unlocked
# by the time you commit, thanks to macOS Keychain integration).
[gpg "ssh"]
    program = /opt/1Password/op-ssh-sign
{{ else }}
# Linux: op-ssh-sign cannot trigger a polkit unlock dialog when 1Password is locked.
# ssh-keygen routes through SSH_AUTH_SOCK (the 1Password agent), which CAN pop up
# a system-auth dialog on demand.
[gpg "ssh"]
    program = /usr/bin/ssh-keygen
{{ end }}

[commit]
    gpgsign = true

[push]
    autoSetupRemote = true

[init]
    defaultBranch = main

[core]
    excludesfile = ~/.config/git/ignore
    pager = delta
    # Global secret-scanning pre-commit hook for ALL repos. Repos that set their
    # own repo-local core.hooksPath (Husky v9, lefthook) override this and are
    # unaffected. See dot_config/git/hooks/executable_pre-commit.
    hooksPath = ~/.config/git/hooks

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    syntax-theme = base16

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
    algorithm = histogram

[rerere]
    enabled = true

[pull]
    rebase = true
{{ if .workEmail }}
# Work identity: repos under the work directory author commits with the work
# email (see the included config-work). Everything else uses the personal
# email in [user] above. Both emails are verified on the same GitHub account,
# and the one signing key works for both, so only the author email changes.
[includeIf "gitdir:{{ .workdir }}/"]
    path = config-work
{{- end }}
