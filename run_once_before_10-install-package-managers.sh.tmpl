#!/usr/bin/env bash
# Bootstrap step 1: install OS-native package manager (if needed) and Layer 3 packages.
# Runs once on first `chezmoi apply`. Idempotent — safe to re-run.
#
# Layer 1 self-managers (mise, uv, rustup, claude, codex) are installed in step 20.
# Layer 2 mise-managed tools are installed in step 30.
#
# Chezmoi exposes the OS via templating (shown without braces so chezmoi does
# NOT evaluate them here -- .chezmoi.osRelease is absent on macOS and would
# error under missingkey=error):
#   .chezmoi.os               → "darwin" | "linux"
#   .chezmoi.osRelease.id     → "pop" | "ubuntu" | "arch" | "fedora" (Linux only)
#   .chezmoi.osRelease.idLike → e.g. "ubuntu debian" for Pop!_OS

set -euo pipefail

log()  { printf '\033[1;34m[bootstrap]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[bootstrap]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[bootstrap]\033[0m %s\n' "$*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

# --- Determine OS + distro from chezmoi templating ---
OS="{{ .chezmoi.os }}"
{{- if eq .chezmoi.os "linux" }}
DISTRO_ID="{{ .chezmoi.osRelease.id }}"
DISTRO_LIKE="{{ .chezmoi.osRelease.idLike | default "" }}"
{{- else }}
DISTRO_ID=""
DISTRO_LIKE=""
{{- end }}

log "OS=${OS} DISTRO_ID=${DISTRO_ID} DISTRO_LIKE=${DISTRO_LIKE}"

# Path to this repo's package lists, available at apply time:
PKG_DIR="{{ .chezmoi.sourceDir }}/packages"
BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile.darwin.tmpl"

# --- Helper: install Homebrew on macOS if missing ---
install_homebrew_if_missing() {
    if have brew; then
        log "Homebrew already installed: $(brew --version | head -1)"
        return
    fi
    log "Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c \
        "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
}

# --- Helper: install brew packages from Brewfile ---
install_brew_packages() {
    log "Installing macOS Homebrew packages from Brewfile..."
    # NB: `--no-lock` was removed from `brew bundle` (Brewfile.lock.json is no
    # longer generated), so passing it now errors. Modern brew bundle is
    # lockfile-free by default.
    brew bundle --file="${BREWFILE}"
}

# --- Helper: install packages from a newline-separated list, ignoring blank/comment lines ---
read_pkg_list() {
    grep -vE '^\s*(#|$)' "$1" | tr '\n' ' '
}

# --- Helper: configure Google Cloud CLI apt repo (google-cloud-cli is not in
# Debian/Ubuntu's default repos). Idempotent. Must run before `apt-get install`. ---
setup_gcloud_apt_repo() {
    local keyring=/usr/share/keyrings/cloud.google.gpg
    local list=/etc/apt/sources.list.d/google-cloud-sdk.list
    if [ -f "$keyring" ] && [ -f "$list" ]; then
        log "Google Cloud apt repo already configured."
        return
    fi
    log "Configuring Google Cloud apt repo..."
    sudo apt-get update
    sudo apt-get install -y apt-transport-https ca-certificates gnupg curl
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | sudo gpg --dearmor -o "$keyring"
    echo "deb [signed-by=${keyring}] https://packages.cloud.google.com/apt cloud-sdk main" \
        | sudo tee "$list" >/dev/null
}

# --- Helper: configure Google Cloud CLI dnf repo (Fedora consumes Google's EL9
# yum repo). Idempotent. Must run before `dnf install`. Settings mirror Google's
# documented RHEL/Fedora repo; $basearch resolves to x86_64 on the owner's box.
# aarch64 yum coverage lags — pin the arch in baseurl if installing on ARM. ---
setup_gcloud_dnf_repo() {
    local repo=/etc/yum.repos.d/google-cloud-cli.repo
    if [ -f "$repo" ]; then
        log "Google Cloud dnf repo already configured."
        return
    fi
    log "Configuring Google Cloud dnf repo..."
    sudo tee "$repo" >/dev/null <<'EOF'
[google-cloud-cli]
name=Google Cloud CLI
baseurl=https://packages.cloud.google.com/yum/repos/cloud-sdk-el9-$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://packages.cloud.google.com/yum/doc/rpm-package-key.gpg
EOF
}

# --- OS dispatch ---
# Match on $DISTRO_ID first (most specific). Fall back to $DISTRO_LIKE for
# derivatives we haven't named explicitly. Keep it as a flat routing table.
case "$OS" in
    darwin)
        install_homebrew_if_missing
        install_brew_packages
        ;;
    linux)
        case "$DISTRO_ID" in
            pop|ubuntu|debian)
                log "Installing apt packages (id=${DISTRO_ID})..."
                setup_gcloud_apt_repo
                sudo apt-get update
                sudo apt-get install -y $(read_pkg_list "${PKG_DIR}/debian.txt")
                ;;
            arch)
                log "Installing pacman packages..."
                sudo pacman -Syu --noconfirm --needed $(read_pkg_list "${PKG_DIR}/arch.txt")
                ;;
            fedora)
                log "Installing dnf packages..."
                setup_gcloud_dnf_repo
                sudo dnf install -y $(read_pkg_list "${PKG_DIR}/fedora.txt")
                ;;
            *)
                case "$DISTRO_LIKE" in
                    *debian*)
                        log "Falling back to debian via idLike (${DISTRO_LIKE})..."
                        setup_gcloud_apt_repo
                        sudo apt-get update
                        sudo apt-get install -y $(read_pkg_list "${PKG_DIR}/debian.txt")
                        ;;
                    *arch*)
                        log "Falling back to arch via idLike (${DISTRO_LIKE})..."
                        sudo pacman -Syu --noconfirm --needed $(read_pkg_list "${PKG_DIR}/arch.txt")
                        ;;
                    *fedora*|*rhel*)
                        log "Falling back to fedora via idLike (${DISTRO_LIKE})..."
                        setup_gcloud_dnf_repo
                        sudo dnf install -y $(read_pkg_list "${PKG_DIR}/fedora.txt")
                        ;;
                    *)
                        die "Unsupported Linux distro: id=${DISTRO_ID} idLike=${DISTRO_LIKE}"
                        ;;
                esac
                ;;
        esac
        ;;
    *)
        die "Unsupported OS: ${OS}"
        ;;
esac

log "Layer 3 packages installed."
