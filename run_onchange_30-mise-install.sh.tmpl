#!/usr/bin/env bash
# Bootstrap step 3: materialize Layer 2 tools via mise, then install npm-globals
# that depend on Node.
#
# This is `run_onchange_*` (not `run_once_*`) — chezmoi re-runs it whenever the
# rendered script content changes. The mise.toml hash below gets embedded in
# the rendered script, so any edit to mise.toml re-triggers this step:
#
# mise.toml hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

set -euo pipefail

log() { printf '\033[1;34m[bootstrap]\033[0m %s\n' "$*"; }

# Ensure mise + its shims are on PATH (mise installer adds them but our shell
# may not have re-sourced rc yet).
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

if ! command -v mise >/dev/null 2>&1; then
    echo "mise not found — step 20 must run first" >&2
    exit 1
fi

# This installs ~30 tools from GitHub releases in one shot, which can blow
# through the unauthenticated API rate limit on a fresh machine (see README).
# So bootstrap `gh` itself FIRST -- one tool, a handful of API calls -- and log
# it in, then spend its token on the big install. The login also asks for
# admin:ssh_signing_key up front, the scope step 60 needs to upload a signing
# key, so that step doesn't have to send you through a second browser flow.
#
# Every part of this is best-effort: a missing/skipped login degrades to the
# same soft warning as before (`mise install` may well succeed anyway), never a
# hard fail. Interactive login only with a TTY, so headless applies don't hang.
if [ -z "${GITHUB_TOKEN:-}" ] && [ -z "${MISE_GITHUB_TOKEN:-}" ]; then
    if ! command -v gh >/dev/null 2>&1; then
        log "Installing gh ahead of the rest, to authenticate this install..."
        mise install aqua:cli/cli && mise reshim 2>/dev/null || true
    fi
    if command -v gh >/dev/null 2>&1 && ! gh auth status >/dev/null 2>&1 && [ -t 0 ]; then
        log "Logging gh in to GitHub (Ctrl-C to skip -- the install may then hit the rate limit)..."
        gh auth login -h github.com -s admin:ssh_signing_key || true
    fi
    if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
        GITHUB_TOKEN="$(gh auth token)"
        export GITHUB_TOKEN
        log "No GITHUB_TOKEN set; using 'gh auth token' to avoid GitHub API rate limits."
    else
        echo "[bootstrap] WARN: no GITHUB_TOKEN/MISE_GITHUB_TOKEN set and 'gh' isn't authenticated." >&2
        echo "[bootstrap] WARN: mise install pulls ~30 tools from GitHub releases and may hit the" >&2
        echo "[bootstrap] WARN: unauthenticated rate limit. export GITHUB_TOKEN=<a PAT> and re-run" >&2
        echo "[bootstrap] WARN: if this fails, or 'mise cache clear' if a tool resolves to 'vlatest'." >&2
    fi
fi

log "Running mise install (Layer 2 tools)..."
mise install
mise reshim 2>/dev/null || true

# --- Corepack: enables corepack-managed pnpm/yarn/npm shims ---
# Reads packageManager field from each repo's package.json. Activates pnpm
# globally as a baseline for use outside any specific project.
if command -v corepack >/dev/null 2>&1; then
    log "Enabling corepack and activating pnpm baseline..."
    corepack enable
    corepack prepare pnpm@latest --activate
fi

# --- Codex CLI via npm (self-managing thereafter) ---
# Upgrade pattern: `npm update -g @openai/codex`.
if command -v codex >/dev/null 2>&1; then
    log "codex already installed"
else
    log "Installing Codex via npm..."
    npm install -g @openai/codex
fi

log "Layer 2 + npm-globals ready."
