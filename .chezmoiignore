# Files chezmoi should NOT manage.
#
# IMPORTANT: patterns are matched against the TARGET path (home-relative, e.g.
# ".config/foo"), NOT the source path ("dot_config/foo"). Writing source-style
# paths here silently does nothing — verify with `chezmoi managed`.

# --- Repo meta files (live only in the git repo, never deployed to ~) ---
README.md
CLAUDE.md
LICENSE
.gitignore

# --- Binary / machine-local runtime state ---
.DS_Store
**/.DS_Store
.config/fish/fish_variables

# --- Secret-bearing paths: never let `chezmoi add` pull these into a PUBLIC repo. ---
# Belt-and-suspenders alongside the gitleaks pre-commit hook + GitHub push protection.
.ssh
.gnupg
.aws
.config/gcloud
.kube
.docker
.config/op
.password-store
.config/atuin
.netrc
.npmrc
.pypirc
.config/gh/hosts.yml
.cargo/credentials.toml
.codex
.cursor
.copilot
.cagent
.claude.json
**/*.pem
**/*.key
**/.env
**/.env.*

# --- macOS-only files: ignore on every non-darwin machine ---
{{- if ne .chezmoi.os "darwin" }}
Brewfile.darwin
.config/ghostty/config
{{- end }}

# --- Linux-only files: ignore on darwin ---
{{- if eq .chezmoi.os "darwin" }}
packages
{{- end }}
